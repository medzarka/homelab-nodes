# ==============================================================================
# Homelab Master Node Environment Configuration
# ==============================================================================

# Node Role: MASTER
NODE_ROLE=MASTER

# Node Identification
NODE_NAME=master-node
TS_HOSTNAME=master-node

# Tailscale Authentication & Exit Node Configuration
# To act as an Exit Node, keep --advertise-exit-node (Approve in Tailscale Admin Console)
TS_AUTHKEY=
TS_EXTRA_ARGS=--reset --advertise-exit-node

# Cluster Networking Configuration
SHARED_NETWORK=shared_net
SWARM_NETWORK=homelab_swarm_net

# Persistent Storage Root
DATA_DIR=/srv/data

# Arcane Cockpit Manager
ARCANE_PORT=3552
ARCANE_APP_URL=http://localhost:3552
ALLOW_CLI_PASSWORD_RESET=true
PUID=1000
PGID=1000

# Maintenance Schedule (for host auto-update timer)
UPDATE_DAY=Sun
UPDATE_TIME=04:00
