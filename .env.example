# ==============================================================================
# Homelab Nodes — Global Environment Defaults Template
# ==============================================================================

# Node Identification
NODE_NAME=my-node
TS_HOSTNAME=my-node

# Tailscale Pre-Authentication Key (Optional)
# Get a key from: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_EXTRA_ARGS=--reset

# Persistent Storage Root
DATA_DIR=/srv/data

# Master / Manager Specific Settings
ARCANE_PORT=3552
ARCANE_APP_URL=http://localhost:3552
ALLOW_CLI_PASSWORD_RESET=true
PUID=1000
PGID=1000

# Worker Node Specific Settings
MASTER_TAILSCALE_IP=100.x.y.z
ARCANE_SERVER_URL=http://100.x.y.z:3552
ARCANE_AGENT_TOKEN=
ARCANE_AGENT_NAME=my-node
SWARM_WORKER_TOKEN=

# Host Automated Maintenance Schedule (Systemd Timer)
# Day: Sun, Mon, Tue, Wed, Thu, Fri, Sat
UPDATE_DAY=Sun
# Time: 24-hour format HH:MM
UPDATE_TIME=04:00
