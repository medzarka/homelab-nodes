# ==============================================================================
# Homelab Worker Node Environment Configuration
# ==============================================================================

# Node Identification
NODE_NAME=oci01-flex
TS_HOSTNAME=oci01-flex

# Tailscale Authentication (Optional: Pre-authenticate container)
TS_AUTHKEY=
TS_EXTRA_ARGS=--reset

# Arcane Agent Connection (Obtain Token from Arcane Manager UI -> Add Node)
MASTER_TAILSCALE_IP=100.x.y.z
ARCANE_SERVER_URL=http://100.x.y.z:3552
ARCANE_AGENT_TOKEN=your_arcane_agent_token_here
ARCANE_AGENT_NAME=oci01-flex

# Maintenance Schedule (for host auto-update timer)
UPDATE_DAY=Sun
UPDATE_TIME=04:00
